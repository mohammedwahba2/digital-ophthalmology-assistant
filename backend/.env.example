# Application Settings
# Copy this file to .env and configure as needed

# Server
HOST=0.0.0.0
PORT=8000

# Application
DEBUG=false
APP_NAME="Digital Ophthalmology Assistant"
APP_VERSION=1.0.0

# Database
# Leave empty to use default SQLite at backend/predictions.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname
# For MySQL: mysql://user:password@localhost:3306/dbname
DATABASE_URL=

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=["*"]

# ML Model
# Leave empty to use default at backend/models/eye_disease_final_cropped.keras
MODEL_PATH=

# File Upload
# Leave empty to use default at backend/uploads/
UPLOAD_DIR=
MAX_UPLOAD_SIZE_MB=10